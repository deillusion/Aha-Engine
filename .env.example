# Copy to .env. Keys stay on the server and are never included in session records.
DEEPSEEK_API_KEY=
GLM_API_KEY=
GEMINI_API_KEY=
PORT=27333
# Optional: restrict every Agent session to this workspace root.
# VARINA_WORKSPACE_ROOT=D:/my-creative-project
# Optional HTTP/Mixed proxy port; otherwise read Windows system proxy.
# VARINA_PROXY_URL=http://127.0.0.1:7890 (or AHA_PROXY_URL)
